{
  "name": "OR-Generator — QR Studio",
  "short_name": "OR-Generator",
  "description": "A fast, private, installable QR code generator and scanner.",
  "id": "/OR-Generator/",
  "start_url": "/OR-Generator/",
  "scope": "/OR-Generator/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "theme_color": "#070a14",
  "background_color": "#070a14",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "/OR-Generator/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/OR-Generator/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Scan QR",
      "short_name": "Scan",
      "url": "/OR-Generator/#/scanner",
      "icons": [{ "src": "/OR-Generator/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Create QR",
      "short_name": "Create",
      "url": "/OR-Generator/#/generator",
      "icons": [{ "src": "/OR-Generator/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
}